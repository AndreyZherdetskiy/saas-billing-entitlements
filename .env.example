# Environment template (single SoT — repo root)
#
# Copy to repo-root .env (gitignored). Do not maintain a second copy under deploy/compose/.
#
# Compose / Make / host tools all read this file:
# - interpolation: docker compose --env-file .env -f deploy/compose/docker-compose.yml
#   (app services use environment: + ${DATABASE_URL} — not env_file dump)
# - pydantic / Makefile / k6: root .env
#
# Values with billing:billing / local webhook secret are local/demo only — never production.
# Helm/K8s: same keys via deploy/helm/billing-platform/values.yaml (inject secrets at install).

POSTGRES_USER=billing
POSTGRES_PASSWORD=billing
POSTGRES_DB=billing
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator

DATABASE_URL=postgresql+asyncpg://billing:billing@postgres:5432/billing
# billing-api runs alembic on start; set false to skip:
# RUN_MIGRATIONS=false
# Stage3 PgBouncer profile (`docker compose --profile pgbouncer up -d`):
# DATABASE_URL=postgresql+asyncpg://billing:billing@pgbouncer:5432/billing
# (host tools: localhost:6432). Optional RO replica:
# DATABASE_READ_URL=postgresql+asyncpg://billing:billing@postgres-replica:5432/billing
# Optional RO via bouncer (profiles postgres-replica + pgbouncer-replica):
# DATABASE_READ_URL=postgresql+asyncpg://billing:billing@pgbouncer-replica:5432/billing
DATABASE_READ_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
REPLICA_LAG_THRESHOLD_SECONDS=30
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ENTITLEMENT_CACHE_TTL_SECONDS=60
AUTH_CACHE_TTL_SECONDS=2
ENTITLEMENT_L1_TTL_SECONDS=1
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
MOCK_STRIPE_WEBHOOK_SECRET=whsec_mock_dev
MOCK_STRIPE_WEBHOOK_SECRET_PREVIOUS=
# Compose default when unset: value from this file after `cp .env.example .env`.
# Rate limits: 120/min (org keys), 1000/min (platform_admin). Set both to 0 only on
# local load/perf stands (`make load-perf-env`) — NEVER in production.
# When Redis is unavailable, the API fails closed (HTTP 503).
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_PLATFORM_ADMIN_PER_MINUTE=1000
RECONCILIATION_ALERT_AMOUNT_CENTS=10000
GRACE_ENFORCEMENT_INTERVAL_SECONDS=60
DUNNING_ENABLED=false
MOCK_STRIPE_BASE_URL=http://mock-stripe:8001
OTEL_EXPORTER_OTLP_ENDPOINT=
# Local default: true (SDK off — safe for k6). Set false + OTLP endpoint for traces/metrics.
OTEL_SDK_DISABLED=true
SHUTDOWN_GRACE_SECONDS=30
HEALTH_KAFKA_OPTIONAL=false
KAFBAT_UI_PORT=8081

# Grafana (observability profile) — local demo only
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Demo UI — defaults match billing_platform.bootstrap.demo_seed (local only).
# Leave DEMO_UI_API_BASE_URL empty in Docker: nginx proxies /v1 and /health to billing-api.
DEMO_UI_API_BASE_URL=
DEMO_UI_API_KEY=bp_local_demo_platform_admin_key_v1
DEMO_UI_PLATFORM_ADMIN_API_KEY=bp_local_demo_platform_admin_key_v1
DEMO_UI_ORG_ID=01900000-0000-7000-8000-000000000001
DEMO_UI_FEATURE_KEYS=api_calls,seats

# billing-api entrypoint (compose): alembic + demo seed. Optional:
# RUN_MIGRATIONS=false
# RUN_DEMO_SEED=false

# k6 (§8.1.1) — same deterministic demo key/org, or after seed_prod_like:
K6_API_KEY=bp_local_demo_platform_admin_key_v1
K6_ORG_ID=01900000-0000-7000-8000-000000000001
K6_FEATURE_KEY=api_calls
K6_PROFILE=smoke
BASE_URL=http://localhost:8000
# K6_BATCH_SIZE=100
# K6_SOAK_DURATION=30m
# K6_CEILING_RPS=8000

# Locust (additive; make load-locust). Reuses K6_* / BASE_URL.
# LOAD_WAIT_MIN=0.1
# LOAD_WAIT_MAX=0.5
# Ceiling hold (not smoke): LOAD_WAIT_MIN=0 LOAD_WAIT_MAX=0
# Prod-like overlay (not default compose-core): make perf-up
# LOAD_HOST=http://localhost:8000
# LOAD_API_KEY=   # defaults to K6_API_KEY
# LOAD_ORG_ID=    # defaults to K6_ORG_ID
# LOAD_USERS=5
# LOAD_RUN_TIME=10s
