# Local Vite dev — copy to demo_ui/.env
# API key is never baked into Docker images; inject at runtime in compose.
#
# SECURITY: never run `npm run build` with real keys in VITE_* — Vite embeds them in
# static dist/. Use `npm run dev` for local UI, or Docker demo-ui (runtime-config.js).
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=
VITE_PLATFORM_ADMIN_API_KEY=
VITE_DEMO_ORG_ID=
VITE_DEMO_FEATURE_KEYS=api_calls,seats
