    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "sum by (span_name, status_code) (rate(traces_spanmetrics_calls_total{service=\"billing-api\"}[5m]))",
          "legendFormat": "{{span_name}} ({{status_code}})",
          "refId": "A"
        }
      ],
      "title": "billing-api span mix",
      "type": "timeseries"
