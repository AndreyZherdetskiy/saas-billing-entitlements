FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RUN_MIGRATIONS=true \
    RUN_DEMO_SEED=true

RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app

COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY src ./src
COPY alembic ./alembic
COPY deploy/docker/api-entrypoint.sh /api-entrypoint.sh

RUN pip install --no-cache-dir . \
    && chmod +x /api-entrypoint.sh \
    && chown -R app:app /app /api-entrypoint.sh

USER app

EXPOSE 8000

ENTRYPOINT ["/api-entrypoint.sh"]
CMD ["sh", "-c", "uvicorn billing_platform.main:app --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown ${SHUTDOWN_GRACE_SECONDS:-30}"]
