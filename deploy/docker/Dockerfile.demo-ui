# syntax=docker/dockerfile:1

FROM node:22-alpine AS build

WORKDIR /app/demo_ui

COPY demo_ui/package.json demo_ui/package-lock.json* ./
RUN npm install

COPY demo_ui/ ./

# Static build only — API key/base URL injected at container start via runtime-config.js.
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY deploy/docker/demo-ui-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/demo_ui/dist /usr/share/nginx/html
COPY deploy/docker/demo-ui-entrypoint.sh /docker-entrypoint.d/40-demo-ui-config.sh

RUN chmod +x /docker-entrypoint.d/40-demo-ui-config.sh \
    && sed -i 's|/run/nginx.pid|/tmp/nginx.pid|' /etc/nginx/nginx.conf \
    && sed -i 's/^user /# user /' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
        /etc/nginx/conf.d /docker-entrypoint.d

USER nginx

EXPOSE 8080

# DEMO_UI_API_KEY, DEMO_UI_ORG_ID, etc. are read at container start only.
CMD ["nginx", "-g", "daemon off;"]
