FROM python:3.12-slim

WORKDIR /app

RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app

RUN pip install --no-cache-dir \
    "fastapi>=0.141,<0.142" \
    "uvicorn[standard]>=0.32,<0.53" \
    "httpx>=0.28,<0.29" \
    "pydantic>=2.10,<3"

COPY deploy/docker/mock_stripe_app.py ./mock_stripe_app.py
RUN chown -R app:app /app

USER app

EXPOSE 8001

CMD ["uvicorn", "mock_stripe_app:app", "--host", "0.0.0.0", "--port", "8001"]
